// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  name  String?
  email String? @unique
  image String?

  firstName String?
  lastName  String?

  accounts Account[]
  sessions Session[]

  channels             Channel[]
  subscription         ChannelSubscription[]
  platformSubscription PlatformSubscription?
  streamChatMessages   StreamChatMessage[]

  like    Like[]
  comment Comment[]

  watchHistory WatchHistory[]
  watchLater   WatchLater[]
  playlists    Playlist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String

  token String

  expires DateTime

  @@unique([identifier, token])
}

model Channel {
  id                String                @id @default(cuid())
  channelName       String                @unique
  bannerUrl         String?
  profilePictureUrl String?
  description       String
  subscriberCount   Int                   @default(0)
  userId            String
  owner             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos            Upload[]
  subscription      ChannelSubscription[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  liveStreams LiveStream[]
}

model ChannelSubscription {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, channelId])
  @@index([userId])
  @@index([channelId])
}

enum PlatformPlan {
  FREE
  PREMIUM
  FAMILY
  STUDENT
}

model PlatformSubscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan PlatformPlan @default(FREE)

  startedAt DateTime  @default(now())
  expiresAt DateTime?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VideoType {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum UploadStatus {
  PROCESSING
  READY
  FAILED
}

model Upload {
  id String @id @default(cuid())

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  originalVideoUrl String?
  playbackUrl      String?

  thumbnailUrl String?

  title       String @db.Text
  description String @db.Text

  duration Int?

  type VideoType

  status UploadStatus @default(PROCESSING)

  viewCount Int @default(0)

  deletedAt DateTime?

  like           Like[]
  comment        Comment[]
  playlistVideos PlaylistVideo[]
  watchHistory   WatchHistory[]
  watchLater     WatchLater[]

  variants VideoVariant[]

  processingJobs VideoProcessingJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channelId])
  @@index([createdAt])
  @@index([status])
}

model Like {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  videoId String?
  video   Upload? @relation(fields: [videoId], references: [id], onDelete: Cascade)

  LiveStreamId String?
  liveStream   LiveStream? @relation(fields: [LiveStreamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, videoId])
  @@unique([userId, LiveStreamId])
}

model Comment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  videoId     String?
  video       Upload? @relation(fields: [videoId], references: [id], onDelete: Cascade)
  commentText String

  parentId String? // NEW: For nested replies
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  LiveStreamId String?
  liveStream   LiveStream? @relation(fields: [LiveStreamId], references: [id], onDelete: Cascade)

  deletedAt DateTime?
  isEdited  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([videoId])
  @@index([LiveStreamId])
  @@index([parentId])
}

model Playlist {
  id          String  @id @default(cuid())
  title       String
  description String? @db.Text

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  playlistVideos PlaylistVideo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PlaylistVideo {
  id String @id @default(cuid())

  playlistId String
  uploadId   String

  order Int

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  upload Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([playlistId, uploadId])
  @@index([playlistId])
  @@index([uploadId])
}

enum StreamStatus {
  LIVE
  ENDED
  SCHEDULED
}

model LiveStream {
  id String @id @default(cuid())

  title       String @db.Text
  description String @db.Text

  thumbnailUrl String?

  ingestUrl   String?
  playbackUrl String?

  streamKey String @unique

  isChatEnabled Boolean @default(true)

  concurrentViewers Int @default(0)
  totalViews        Int @default(0)

  status StreamStatus @default(SCHEDULED)

  scheduledFor DateTime?

  recordingUrl String?

  startedAt DateTime?
  endedAt   DateTime?

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  comments     Comment[]
  chatMessages StreamChatMessage[]

  like Like[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channelId])
  @@index([status])
  @@index([scheduledFor])
}

model WatchHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String
  video     Upload   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  watchedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
  @@index([watchedAt])
}

model WatchLater {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadId  String
  upload    Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, uploadId])
  @@index([userId])
  @@index([uploadId])
}

enum ProcessingJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model VideoProcessingJob {
  id String @id @default(cuid())

  uploadId String
  upload   Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  status ProcessingJobStatus @default(QUEUED)

  progress Int @default(0)

  retryCount Int @default(0)

  errorMessage String? @db.Text

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uploadId])
  @@index([status])
}

model StreamChatMessage {
  id String @id @default(cuid())

  streamId String
  stream   LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  message String @db.Text

  createdAt DateTime @default(now())

  @@index([streamId])
  @@index([createdAt])
}

model VideoVariant {
  id String @id @default(cuid())

  uploadId String
  upload   Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  resolution String
  bitrate    Int

  playlistUrl String

  createdAt DateTime @default(now())

  @@unique([uploadId, resolution])
  @@index([uploadId])
}

enum VideoResolution {
  P360
  P480
  P720
  P1080
  P1440
  P2160
}
